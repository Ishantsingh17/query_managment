# Copy to backend/.env and adjust. Never commit backend/.env.
GROQ_API_KEY=
AEP_ENVIRONMENT=development
AEP_SECRET_KEY=change-me-to-a-long-random-string
AEP_APP_BASE_URL=http://localhost:5173
AEP_SOURCE_API_BASE_URL=http://127.0.0.1:8000
AEP_MOCK_LATENCY_MS=250
AEP_RETRIEVAL_MAX_ATTEMPTS=2

# LLM (required, no rules mode): "groq" (uses GROQ_API_KEY) or "langchain" (init_chat_model model string)
AEP_LLM_PROVIDER=groq
AEP_LLM_MODEL=openai/gpt-oss-120b
AEP_LLM_AGENTIC_RETRIEVAL=true

# Notifications: "console" (log + record only), "gmail" (SMTP + App Password) or "gmail_api" (HTTPS + OAuth)
AEP_NOTIFICATION_PROVIDER=console
AEP_GMAIL_SENDER=singhishant01feb@gmail.com
# --- Option A: Gmail SMTP (needs outbound ports 465/587) ---
# Gmail App Password (Google Account > Security > App passwords). Never commit it.
AEP_GMAIL_APP_PASSWORD=
AEP_GMAIL_SMTP_PORT=465
# Dev: deliver every notification to this inbox instead of the (fictional) user addresses
AEP_NOTIFICATION_RECIPIENT_OVERRIDE=
# Dev: per-role recipients (take precedence over the global override above)
AEP_NOTIFY_VALIDATOR_EMAIL=
AEP_NOTIFY_SME_EMAIL=
AEP_NOTIFY_AUDITOR_EMAIL=

# --- Option B: Gmail API over HTTPS (use when SMTP ports are blocked, e.g. corporate network) ---
# Filled in automatically by: python -m app.notifications.gmail_oauth_setup path\to\client_secret.json
AEP_GMAIL_OAUTH_CLIENT_ID=
AEP_GMAIL_OAUTH_CLIENT_SECRET=
AEP_GMAIL_OAUTH_REFRESH_TOKEN=

# --- LLM observability (backend/observability; see backend/observability/README.md) ---
OBSERVABILITY_ENABLED=true
# Single append-only JSON Lines file (relative paths resolve against backend/)
OBSERVABILITY_LOG_FILE=logs/llm_observability.jsonl
OBSERVABILITY_LOG_ROTATION_ENABLED=false
# Payload capture is OFF by default (metadata only). Enable in development only; values are always redacted.
OBSERVABILITY_CAPTURE_INPUTS=false
OBSERVABILITY_CAPTURE_OUTPUTS=false
OBSERVABILITY_CAPTURE_MESSAGES=false
OBSERVABILITY_REDACTION_ENABLED=true
# Extra organization-specific sensitive keys (comma-separated) / regexes (JSON list)
OBSERVABILITY_REDACT_FIELDS=
OBSERVABILITY_REDACT_PATTERNS=
OBSERVABILITY_COST_TRACKING_ENABLED=false
OBSERVABILITY_FAIL_OPEN=true
# LangSmith remote tracing: sends data only when ENABLED + TRACING are true AND an API key is set. Never commit the key.
LANGSMITH_ENABLED=true
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=audit-evidence-platform
# Only for self-hosted / regional LangSmith deployments
LANGSMITH_ENDPOINT=
