# --- Groq LLM -------------------------------------------------------------
# Without a key the Query Understanding Agent falls back to a deterministic
# rule-based parser, so the POC still runs end to end.
GROQ_API_KEY=
# List what your account actually serves:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-120b

# --- Workflow -------------------------------------------------------------
# Bounded retry attempts for missing evidence.
MAX_RETRIES=2
# Pacing between workflow stages so the sequential DB search is visible in the
# UI during a demo. Set to 0 for instant runs and tests.
DEMO_STEP_DELAY_MS=700

# --- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
